# .env.example
# Copy to .env and fill in. .env is git-ignored (never commit real secrets).
#
#   cp .env.example .env
#
# These values wire together the public EMQX broker, InfluxDB, Telegraf and Grafana.

# ---------- MQTT (public EMQX test broker) ----------
# broker.emqx.io is public and unauthenticated; user/pass are not enforced but are
# kept here so the same values can be reused in the devices' include/secrets.h.
MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_USER=emqx
MQTT_PASS=public

# ---------- InfluxDB v2 (auto-initialised on first run) ----------
INFLUX_USERNAME=admin
INFLUX_PASSWORD=change-me-influx-admin
INFLUX_ORG=basil-farm
INFLUX_BUCKET=basil
# Admin token used by Telegraf (write) and Grafana (read). Use a long random string.
INFLUX_TOKEN=change-me-super-secret-influx-token

# ---------- Grafana ----------
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana
